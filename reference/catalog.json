{
  "schemaVersion": "1.0.0",
  "package": "@konitif/nodal",
  "intent": "Make a graph editable, validatable and executable without conflating its model, dialect and runtime.",
  "clusters": [
    {
      "id": "headless-projection-mechanics",
      "title": "Headless projection mechanics",
      "summary": "Derive coordinates, grids, connection drafts, port states and group layouts without a renderer.",
      "authority": "Deterministic projection values, not graph mutation or execution.",
      "owns": ["coordinate transforms", "viewport grid", "connection interaction plans", "port states", "group layout"],
      "doesNotOwn": ["DOM measurement", "pointer targets", "persistence", "command admission"],
      "workflow": ["Observe", "Calculate", "Project"],
      "sourcePrefixes": ["projection/"]
    },
    {
      "id": "graph-authority",
      "title": "Graph and commands",
      "summary": "Canonical graph state and admitted mutations.",
      "authority": "Nodal graph authority.",
      "owns": ["nodes", "edges", "commands", "commits"],
      "doesNotOwn": ["rendering", "execution"],
      "workflow": ["Declare", "Command", "Commit"],
      "sourcePrefixes": [
        "core/commands",
        "core/commit",
        "core/graph",
        "core/serializer",
        "core/validation",
        "core/nodeSemantics"
      ],
      "sources": []
    },
    {
      "id": "composition",
      "title": "Composition and editing",
      "summary": "Adapt graph projections to the external Composition authority.",
      "authority": "Derived editing artifacts.",
      "owns": ["projection patches", "shadow editing", "adaptation"],
      "doesNotOwn": ["Composition contracts", "committed Composition"],
      "workflow": ["Derive", "Inspect", "Apply"],
      "sourcePrefixes": ["composition/"]
    },
    {
      "id": "dialects",
      "title": "Dialects",
      "summary": "Compose versioned schema, admission and execution contributions without hiding their ownership.",
      "authority": "Host-selected dialect contributions.",
      "owns": ["registry lifecycle", "schema composition", "admission composition", "executor bindings", "mathematical reference dialect"],
      "doesNotOwn": ["global registry", "domain dialect", "projection presentation"],
      "workflow": ["Register", "Activate", "Resolve", "Deactivate", "Dispose"],
      "sourcePrefixes": ["dialects/registry", "dialects/math"]
    },
    {
      "id": "projection-contributions",
      "title": "Projection contributions",
      "summary": "Resolve host-scoped presentations for extensible projection kinds.",
      "authority": "Host-selected projection configuration.",
      "owns": ["registry contract", "lifecycle", "fallback presentation"],
      "doesNotOwn": ["global registry", "renderer implementation", "domain theme"],
      "workflow": ["Register", "Activate", "Resolve", "Deactivate", "Dispose"],
      "sourcePrefixes": ["dialects/presentation", "core/nodePresentation"]
    },
    {
      "id": "runtime",
      "title": "Execution and observation",
      "summary": "Execute a graph and expose its runtime readings.",
      "authority": "Observable Nodal execution.",
      "owns": ["execution", "compatibility", "read models"],
      "doesNotOwn": ["domain meaning"],
      "workflow": ["Admit", "Execute", "Observe"],
      "sourcePrefixes": ["runtime/"]
    },
    {
      "id": "contracts",
      "title": "Public contracts",
      "summary": "Shared types and registries.",
      "authority": "Nodal integration contracts.",
      "owns": ["types", "registries", "tool module"],
      "doesNotOwn": ["providers"],
      "workflow": ["Declare", "Resolve", "Use"],
      "sourcePrefixes": ["types/"],
      "sources": ["toolModule.ts"]
    }
  ]
}
