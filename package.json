{
  "name": "@konitif/nodal",
  "license": "PolyForm-Noncommercial-1.0.0",
  "version": "0.284.2",
  "private": false,
  "type": "module",
  "description": "Product-neutral graph authoring, validation, serialization and deterministic execution for KONITIF applications.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeMouf/konitif-nodal.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "LICENSE.md",
    "dist",
    "README.md",
    "package.json",
    "reference"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "prepack": "npm run build && npm test",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@konitif/composition": "0.284.3",
    "@konitif/tools": "0.284.4"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
